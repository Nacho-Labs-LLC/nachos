{
  "name": "nachos-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nachos - Docker-native, modular AI assistant framework",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nacho-Labs-LLC/nachos.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "test:docker": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from test",
    "test:docker:down": "docker compose -f docker-compose.test.yml down -v",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "pnpm": {
    "overrides": {
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "rollup@>=4.0.0 <4.59.0": "^4.59.0",
      "tar@<=7.5.10": "^7.5.11",
      "flatted@<3.4.2": "^3.4.2",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "ajv@<6.14.0": "^6.14.0",
      "brace-expansion@<1.1.13": "^1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "^2.0.3",
      "qs@<6.14.2": "^6.14.2",
      "@mozilla/readability@<0.6.0": "^0.6.0",
      "undici@>=6.0.0 <6.24.0": "^6.24.0",
      "lodash@<4.17.25": "^4.17.25",
      "fast-xml-parser@<5.3.3": "^5.3.3",
      "vite@>=6.0.0 <=6.4.1": "^6.4.2"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.3"
  }
}
