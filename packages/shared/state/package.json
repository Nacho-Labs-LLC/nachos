{
  "name": "@nachos/state",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "State layer for Nachos - identity, memory, bootstrap, user profiles, and session state",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nachos/context-manager": "workspace:*",
    "@nacho-labs/nachos-embeddings": "^0.4.1",
    "@nachos/types": "workspace:*",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "uuid": "^13.0.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.11",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
