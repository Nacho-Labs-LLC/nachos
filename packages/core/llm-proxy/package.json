{
  "name": "@nachos/llm-proxy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nachos LLM Proxy - LLM provider abstraction",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1029.0",
    "@google/generative-ai": "^0.24.1",
    "@nachos/bus": "workspace:*",
    "@nachos/config": "workspace:*",
    "@nachos/types": "workspace:*",
    "openai": "^6.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
