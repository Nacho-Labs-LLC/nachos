{
  "name": "@nachos/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nachos Admin UI — web interface for managing the bot and its settings",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "vite --config vite.config.ts",
    "build:frontend": "vite build --config vite.config.ts",
    "build:backend": "tsc --build",
    "build": "pnpm build:frontend && pnpm build:backend",
    "start": "node dist/server.js",
    "typecheck": "tsc --build && vue-tsc --noEmit --project frontend/tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@iarna/toml": "^2.2.5",
    "@nachos/bus": "workspace:*",
    "@nachos/config": "workspace:*",
    "@nachos/types": "workspace:*",
    "better-sqlite3": "^12.6.2",
    "cron-parser": "^5.5.0",
    "hono": "^4.12.12",
    "markdown-it": "^14.1.0",
    "nats": "^2.29.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/iarna__toml": "^2.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^6.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.0.8",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  }
}
