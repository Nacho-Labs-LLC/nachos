{
  "name": "@nachos/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nachos Gateway - Session management and routing",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@composio/core": "^0.6.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nacho-labs/nachos-dlp": "^1.0.0",
    "@nachos/bus": "workspace:*",
    "@nachos/config": "workspace:*",
    "@nachos/context-manager": "workspace:*",
    "@nachos/state": "workspace:*",
    "@nachos/types": "workspace:*",
    "@playwright/mcp": "^0.0.45",
    "better-sqlite3": "^12.6.2",
    "cron-parser": "^5.5.0",
    "dockerode": "^4.0.2",
    "luxon": "^3.7.2",
    "pg": "^8.13.1",
    "playwright-core": "^1.50.0",
    "redis": "^4.7.0",
    "uuid": "^13.0.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^3.3.27",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
