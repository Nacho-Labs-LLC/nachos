{
  "name": "@nachos/tool-web-fetch",
  "version": "0.1.0",
  "description": "HTTP fetch + readable extraction tool for NACHOS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "test": "vitest"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "@nachos/types": "workspace:*",
    "@nachos/tool-base": "workspace:*",
    "jsdom": "^24.0.0",
    "nats": "^2.28.2",
    "turndown": "^7.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/mozilla__readability": "^0.4.2",
    "@types/jsdom": "^21.1.6",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "nachos",
    "web",
    "fetch",
    "tool"
  ],
  "author": "Nachos Team",
  "license": "MIT"
}
