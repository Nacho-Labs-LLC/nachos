{
  "name": "@nachos/tool-code-runner",
  "version": "0.0.0",
  "description": "Code execution tools for NACHOS (Python and JavaScript)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "test": "vitest"
  },
  "dependencies": {
    "@nachos/types": "workspace:*",
    "@nachos/tool-base": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "nachos",
    "code-runner",
    "python",
    "javascript",
    "sandbox",
    "tool"
  ],
  "author": "Nachos Team",
  "license": "MIT"
}
