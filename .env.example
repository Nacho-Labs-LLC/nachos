# Nachos Development Environment Variables
# Copy this file to .env and fill in your values
# Docker Compose reads .env automatically

# ==================== LLM API Keys ====================
# At least one LLM provider key is required

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# Claude subscription (setup-token from `claude setup-token`)
ANTHROPIC_SETUP_TOKEN=
# Optional extra subscription token for multi-profile setups
ANTHROPIC_SETUP_TOKEN_2=

# OpenAI (GPT)
OPENAI_API_KEY=

# ==================== Security Settings ====================
# Options: strict, standard, permissive
SECURITY_MODE=standard

# Rate limiting
GATEWAY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_MESSAGES=30
SECURITY_RATE_LIMIT_TOOLS=15
SECURITY_RATE_LIMIT_LLM=30
REDIS_URL=redis://localhost:6379

# ==================== Development Settings ====================
# Set to 'development' for verbose logging
NODE_ENV=development

# Log level: error, warn, info, debug, trace
LOG_LEVEL=debug

# ==================== Gateway / Browser Tool ====================
# Allowed domain patterns for browser tool
BROWSER_ALLOWED_DOMAINS=*
# Use headless browser mode (true/false)
BROWSER_HEADLESS=true
# Browser action timeout in milliseconds
BROWSER_TIMEOUT_MS=30000

# ==================== Channel Secrets ====================
# Slack
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Discord
DISCORD_BOT_TOKEN=
CHANNEL_DISCORD_ENABLED=true

# Discord server access (configures guild/channel/user allowlists via env instead of nachos.toml)
# Right-click your server name in Discord (Developer Mode on) → Copy Server ID
CHANNEL_DISCORD_GUILD_ID=
# Comma-separated channel IDs to listen in (leave empty to allow all channels in the guild)
CHANNEL_DISCORD_CHANNEL_IDS=
# Comma-separated Discord user IDs allowed to message the bot (required — empty = deny all)
CHANNEL_DISCORD_USER_ALLOWLIST=
# Require @mention before the bot responds (true/false)
CHANNEL_DISCORD_MENTION_GATING=false
# Comma-separated user IDs allowed to DM the bot (omit key entirely to disable DMs)
# CHANNEL_DISCORD_DM_ALLOWLIST=

# Telegram
TELEGRAM_BOT_TOKEN=

# WhatsApp (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ==================== Tooling ====================
# Pairing token for channels that support pairing
NACHOS_PAIRING_TOKEN=

# Code runner (seconds)
CODE_EXECUTION_TIMEOUT=30
