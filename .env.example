# Nachos Environment Variables
# Copy this file to .env and fill in your values
# Docker Compose reads .env automatically
#
# RULE: Only secrets go here. All configuration lives in nachos.toml.
#
# WARNING: Never commit your .env file with real tokens/keys.
# This file (.env.example) should only contain empty placeholders.

# ==================== Security Settings ====================
# Options: strict, standard, permissive
# Default: standard (recommended). Strict denies all tools and DMs by default.
# WARNING: Do NOT use "permissive" in production -- it disables most security controls.
SECURITY_MODE=standard

# ==================== Infrastructure Secrets ====================
# NATS authentication token (must match docker-compose NATS_TOKEN)
# Generate a strong random token: openssl rand -hex 32
NATS_TOKEN=

# Redis password (must match docker-compose REDIS_PASSWORD)
# Generate a strong random password: openssl rand -hex 32
REDIS_PASSWORD=

# ==================== LLM API Keys ====================
# At least one LLM provider key is required

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# Optional second key for multi-profile rotation
ANTHROPIC_API_KEY_2=

# OpenAI (GPT)
OPENAI_API_KEY=

# ==================== Channel Secrets ====================
# Slack
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Discord
DISCORD_BOT_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=

# WhatsApp (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ==================== Other ====================
# Pairing token for channels that support pairing
NACHOS_PAIRING_TOKEN=

# Optional: override the path to nachos.toml (defaults to ./nachos.toml)
# NACHOS_CONFIG_PATH=/path/to/nachos.toml

# Admin UI authentication token.
# If left empty, a random token is generated per session and logged to stdout.
# Set this for stable, persistent admin access.
NACHOS_ADMIN_TOKEN=
