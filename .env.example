# Nachos Environment Variables
# Copy this file to .env and fill in your values
# Docker Compose reads .env automatically
#
# RULE: Only secrets go here. All configuration lives in nachos.toml.

# ==================== LLM API Keys ====================
# At least one LLM provider key is required

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# Claude subscription (setup-token from `claude setup-token`)
ANTHROPIC_SETUP_TOKEN=
# Optional extra subscription token for multi-profile setups
ANTHROPIC_SETUP_TOKEN_2=

# OpenAI (GPT)
OPENAI_API_KEY=

# ==================== Channel Secrets ====================
# Slack
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Discord
DISCORD_BOT_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=

# WhatsApp (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ==================== Other ====================
# Pairing token for channels that support pairing
NACHOS_PAIRING_TOKEN=

# Optional: override the path to nachos.toml (defaults to ./nachos.toml)
# NACHOS_CONFIG_PATH=/path/to/nachos.toml
